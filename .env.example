# Copier ce fichier vers .env puis renseigner la clé. Ne jamais partager .env.
OPENAI_API_KEY=
# Modèle compatible Responses, web_search et Structured Outputs. Modifiable.
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT=180
# Choix initial seulement ; l'utilisateur choisit ensuite dans la barre latérale.
AI_PROVIDER=openai
# Ollama local : télécharger le modèle séparément ou sélectionner un modèle installé.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300
# Clé du service web Ollama, distinct du calcul local gratuit.
OLLAMA_API_KEY=
# Troisième option : Gemini, gratuit sous quotas si le compte relève de l'offre gratuite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIER=free
# Recherche pour Ollama et Gemini : ollama (limites gratuites) ou serper (packs payants).
WEB_SEARCH_PROVIDER=ollama
SERPER_API_KEY=
# Serveur local uniquement. Le port peut être modifié au lancement.
IMPACT_PORT=8765
